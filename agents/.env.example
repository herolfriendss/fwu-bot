# her-agents — copier en .env (ne jamais committer .env)

# --- Bot Discord des agents (un compte de bot à part, PAS celui de FWU) ---
AGENTS_DISCORD_TOKEN=
# Le serveur Discord à observer
AGENTS_GUILD_ID=
# Le salon privé où les agents postent (#agents)
AGENTS_CHANNEL_ID=
# Ton identifiant Discord : toi seul peux cliquer sur les boutons
AGENTS_OWNER_ID=

# --- Ce que l'Observateur a le droit de lire ---
# Identifiants des salons PUBLICS à lire, séparés par des virgules.
# Tout salon absent de cette liste est ignoré (ni compté, ni lu).
AGENTS_READ_CHANNEL_IDS=
# Identifiants des 5 bots, pour repérer leurs messages d'erreur (facultatif)
AGENTS_WATCHED_BOT_IDS=

# --- Base PostgreSQL (sur la VM des agents) ---
AGENTS_DATABASE_URL=postgres://agents:MOT_DE_PASSE@127.0.0.1:5432/agents

# --- IA (API Claude) ---
ANTHROPIC_API_KEY=
# Plafond de dépense mensuel en dollars. Les agents se mettent en pause à 90 %.
AGENTS_MONTHLY_BUDGET_USD=10

# --- Calendrier (heure de Paris) ---
AGENTS_DIGEST_HOUR=9

# --- Secret servant à anonymiser les membres (au moins 32 caractères) ---
# Générer : openssl rand -hex 32
AGENTS_PSEUDONYM_SECRET=

# --- Facultatif : créer un ticket GitHub quand tu valides une proposition ---
# Jeton GitHub limité au dépôt (droits « Issues : lecture et écriture » uniquement)
AGENTS_GITHUB_TOKEN=
AGENTS_GITHUB_REPO=herolfriendss/her-v3-
