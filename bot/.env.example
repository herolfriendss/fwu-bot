# 1942 — configuration du bot (copier en bot/.env, ne jamais committer bot/.env)
# Les valeurs REPLACE_* doivent être remplacées. Le script de déploiement refuse
# de démarrer tant qu'une valeur obligatoire est absente ou laissée en REPLACE_*.

# --- Obligatoire ---
DISCORD_TOKEN=REPLACE_BOT_TOKEN
SITE_URL=https://REPLACE_DOMAINE
# Identique à BOT_SYNC_SECRET du fichier .env du site (32 caractères minimum).
BOT_SYNC_SECRET=REPLACE_SECRET_PARTAGE_32_CARACTERES_MINIMUM
# Serveur PND principal + hub de logs. Ne rien ajouter d'autre.
V4_ALLOWED_GUILD_IDS=1562643485981544559,1570484435239833701
# UN SEUL identifiant Discord : le propriétaire 1942.
# Ne pas définir PND_OWNER_DISCORD_IDS (pluriel) : le bot refuse de démarrer.
PND_OWNER_DISCORD_ID=REPLACE_ID_DISCORD_OWNER
# 64 caractères hexadécimaux. Générer : openssl rand -hex 32
WEBHOOK_ENCRYPTION_KEY=REPLACE_64_HEX

# --- Sécurité : laisser tel quel ---
PND_MZ_ENABLED=false
# Ignoré par le bot (politique propriétaire unique). Peut rester vide.
PND_COFOUNDER_DISCORD_IDS=

# --- Facultatif : valeurs par défaut entre parenthèses ---
# Transcriptions de tickets : 0 = désactivées (défaut), sinon 1 à 90 jours de conservation.
PND_TICKET_TRANSCRIPT_DAYS=0
# Antifraude =pay (7 / 3 / 50000 / 20 / 5 / 14)
PND_TRANSFER_MIN_ACCOUNT_DAYS=7
PND_TRANSFER_MIN_MEMBER_DAYS=3
PND_TRANSFER_DAILY_CAP=50000
PND_TRANSFER_DAILY_COUNT=20
PND_TRANSFER_FUNNEL_SENDERS=5
PND_TRANSFER_YOUNG_MEMBER_DAYS=14
# Réputation (7 / 3 / 5)
PND_REP_MIN_ACCOUNT_DAYS=7
PND_REP_MIN_MEMBER_DAYS=3
PND_REP_DAILY_LIMIT=5
# rankall (5000 membres max, 250 ms entre deux attributions)
PND_RANKALL_MAX_MEMBERS=5000
PND_RANKALL_STEP_DELAY_MS=250
# WAKEUP (1500 ms entre deux déplacements, 60000 ms de délai par auteur)
PND_WAKEUP_STEP_DELAY_MS=1500
PND_WAKEUP_COOLDOWN_MS=60000
# Marketplace d'extensions (désactivé)
MARKETPLACE_ENABLED=false
# Chemins d'outils audio si non présents dans le PATH
# PND_FFMPEG_PATH=/usr/bin/ffmpeg
# Image de thème des panneaux (URL https)
# HER_THEME_IMAGE_URL=

# --- FWU multi-bots (laisser vide tant que les nouveaux bots ne sont pas créés) ---
# Un token par application Discord, JAMAIS le même que DISCORD_TOKEN (FWU).
PND_GUARD_TOKEN=
PND_FDPDLAVOC_TOKEN=
PND_SUCKME_TOKEN=
PND_FISC_TOKEN=
# Serveurs autorisés par bot (vide = même liste que V4_ALLOWED_GUILD_IDS).
PND_GUARD_GUILD_IDS=
PND_FDPDLAVOC_GUILD_IDS=
PND_SUCKME_GUILD_IDS=
PND_FISC_GUILD_IDS=
# Domaines déjà transférés : FWU retire leurs commandes slash de son application.
# Ordre conseillé : guard, puis fdpdlavoc, puis fisc, puis suckme. Exemple : guard,fdpdlavoc
PND_FWU_DELEGATED=
# Identité visuelle par bot (facultatif) : couleur #rrggbb et pied des messages.
# Par défaut : violet, « FWU » / « FWU • GUARD » / « FWU • FDPDLAVOC » / « FWU • SUCK ME » / « FWU • LE FISC ».
# PND_FWU_COLOR=#6d28d9
# PND_GUARD_COLOR=
# PND_GUARD_FOOTER=

# --- DM ALL (propriétaire uniquement) ---
# PND_DMALL_MAX_MEMBERS=1000
# PND_DMALL_STEP_DELAY_MS=1500
# PND_DMALL_COOLDOWN_MS=3600000
