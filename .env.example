# 1942 — configuration du site/dashboard (copier en .env, ne jamais committer .env)

# --- Supabase (Lovable Cloud) ---
VITE_SUPABASE_URL=https://REPLACE.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_PUBLISHABLE_KEY
SUPABASE_URL=https://REPLACE.supabase.co
# Identique à VITE_SUPABASE_PUBLISHABLE_KEY
SUPABASE_PUBLISHABLE_KEY=REPLACE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVICE_ROLE_KEY

# --- Discord ---
DISCORD_CLIENT_ID=REPLACE_CLIENT_ID
DISCORD_CLIENT_SECRET=REPLACE_CLIENT_SECRET
# Même origine HTTPS que SITE_URL du bot
DISCORD_OAUTH_REDIRECT_URI=https://REPLACE_DOMAINE/api/auth/discord/callback
# Même token que DISCORD_TOKEN dans bot/.env
DISCORD_BOT_TOKEN=REPLACE_BOT_TOKEN
# Laisser VIDE : le bot Oracle traite les interactions par la passerelle.
DISCORD_INTERACTIONS_PUBLIC_KEY=

# --- Propriétaire et secrets ---
# Même valeur que dans bot/.env
PND_OWNER_DISCORD_ID=REPLACE_ID_DISCORD_OWNER
PND_COFOUNDER_DISCORD_IDS=
# 32 caractères minimum, différent de BOT_SYNC_SECRET. Générer : openssl rand -hex 32
SESSION_SECRET=REPLACE_SESSION_SECRET_32_CARACTERES_MINIMUM
# Identique à BOT_SYNC_SECRET de bot/.env
BOT_SYNC_SECRET=REPLACE_SECRET_PARTAGE_32_CARACTERES_MINIMUM

# --- Facultatif ---
# Fournisseur IA FWU côté serveur : choisir une clé API (facturation API indépendante d'un abonnement Claude).
# LOVABLE_API_KEY= ou AI_GATEWAY_API_KEY= (Vercel AI Gateway)
# LOVABLE_API_KEY=
# AI_GATEWAY_API_KEY=

# FWU multi-bots : même valeur que PND_FWU_DELEGATED dans bot/.env, pour que le
# bouton « Enregistrer les commandes » du site ne remette pas les commandes transférées.
PND_FWU_DELEGATED=
