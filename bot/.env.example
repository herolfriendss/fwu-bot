# Her? V4 — Node.js 24 LTS requis.
# Jeton du bot : Discord Developer Portal → ton application → Bot → Reset Token
DISCORD_TOKEN=
# URL publique HTTPS du dashboard
SITE_URL=
# Doit être identique à BOT_SYNC_SECRET dans le .env du dashboard
BOT_SYNC_SECRET=

# Required: single Discord server ID authorized for PND Assist V5
PND_ALLOWED_GUILD_ID=
